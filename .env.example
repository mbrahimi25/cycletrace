# Supabase project URL, for example: https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key. Configure INSERT permissions with RLS.
# Do not use a service_role key on the Raspberry Pi.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Carto Basemaps API Key
CARTO_BASEMAPS_API_KEY=your-carto-key